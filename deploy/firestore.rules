// PokerHQ Firestore security rules.
//
// Deployed with: firebase deploy --only firestore:rules --project pokerhq-a67e4
// (firebase.json at the repo root points at this file)
//
// CURRENT STATE (phase 1): every PokerHQ collection requires a signed-in user.
// The app signs in anonymously on load (see js/data/sync.js), so all devices
// keep working automatically — but anonymous drive-by REST reads/writes are blocked.
//
// OPTIONAL TIGHTENING (phase 2): lock the data to your own devices only.
//   1. Open the app on every device you use (desktop + iPhone) so each gets its UID.
//   2. Firebase console -> Authentication -> Users: copy each anonymous UID
//      (or hover the BUILD badge in the app on desktop — it shows "Auth UID").
//   3. Change the isAllowed() function below to:
//        return request.auth != null && request.auth.uid in ['UID_1', 'UID_2'];
//   4. Redeploy with the command above.
// Caution: with anonymous auth, clearing a browser's site data creates a NEW UID,
// which would then need to be added to the list before that device can sync again.

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAllowed() {
      return request.auth != null;
    }

    // Live profile data ("pokerhq-bob") and any future profile collections
    // ("pokerhq-profile-<id>"). Everything else in the database stays denied.
    match /pokerhq-bob/{docId} {
      allow read, write: if isAllowed();
    }
    match /{collection}/{docId} {
      allow read, write: if isAllowed() && collection.matches('pokerhq-profile-.*');
    }
  }
}
