// PokerHQ Firestore security rules.
//
// Deployed with: firebase deploy --only firestore:rules --project pokerhq-a67e4
// (firebase.json at the repo root points at this file)
//
// Access model: the app requires Google sign-in (login gate in js/data/sync.js),
// and the data is locked to the owner's Google account below. Signing in with
// any other account shows an "access denied" message in the app.
//
// To grant another account access, add its email (lowercase) to the list in
// isOwner() and redeploy with the command above.

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in [
          'bobbynacario@gmail.com'
        ];
    }

    // Live profile data ("pokerhq-bob") and any future profile collections
    // ("pokerhq-profile-<id>"). Everything else in the database stays denied.
    match /pokerhq-bob/{docId} {
      allow read, write: if isOwner();
    }
    match /{collection}/{docId} {
      allow read, write: if isOwner() && collection.matches('pokerhq-profile-.*');
    }
  }
}
